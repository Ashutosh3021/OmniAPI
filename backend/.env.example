# OmniAPI Backend - Environment Variables Template
# Copy this file to .env.local and fill in the values.
# Never commit a filled-in copy: .env and .env.local are git-ignored.

# ================================
# Application Configuration
# ================================
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=False              # NEVER set True in production
LOG_LEVEL=info           # Options: debug, info, warning, error, critical
API_TITLE=OmniAPI
API_VERSION=1.0.0

# ================================
# Database (Pyronites)
# ================================
# Pyronites is the data store. The base URL is the backend of your own
# Pyronites deployment; the key authenticates against the project below.
PYRONITES_URL=https://pyrocore-backend.onrender.com
PYRONITES_KEY=pyro_live_replace_me
PYRONITES_PROJECT_ID=omniapi-db
PYRONITES_TIMEOUT=30  # Per-request timeout in seconds

# ================================
# Redis Configuration
# ================================
# Development: redis://localhost:6379/0
# Production options:
#   - AWS ElastiCache: redis://your-cluster.cache.amazonaws.com:6379
#   - Redis Cloud: redis://default:password@endpoint.cloud.redislabs.com:12345
#   - Upstash: redis://default:token@endpoint.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ================================
# Security
# ================================
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-USE-SECURE-RANDOM-KEY

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate ENCRYPTION_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt external API keys in database
ENCRYPTION_KEY=CHANGE-THIS-IN-PRODUCTION-USE-FERNET-KEY

# ================================
# Sign-in (Google / GitHub)
# ================================
# There is no password sign-in. An account is created the first time somebody
# signs in with one of the providers below.
#
# Create an OAuth application in the provider's console and register this
# redirect URI, replacing the host with the public URL of this API:
#
#   Google: https://<api-host>/api/v1/auth/oauth/google/callback
#   GitHub: https://<api-host>/api/v1/auth/oauth/github/callback
#
# Google: https://console.cloud.google.com/apis/credentials
# GitHub: https://github.com/settings/developers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public base URL of this API. Used to build the provider callback URL.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Where the browser is sent after a sign-in. The frontend exchanges the
# one-time code it receives for a token pair.
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/callback
OAUTH_FAILURE_REDIRECT_URL=http://localhost:3000/login?error=oauth_failed

# How long a sign-in attempt and a one-time code stay valid, in seconds.
OAUTH_STATE_TTL_SECONDS=600
OAUTH_CODE_TTL_SECONDS=300

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_FREE=100
RATE_LIMIT_PRO=1000
RATE_LIMIT_ENTERPRISE=10000
RATE_LIMIT_OAUTH_PER_IP=20  # Sign-in attempts per IP per window
RATE_LIMIT_AUTH_WINDOW_SECONDS=900

# ================================
# CORS
# ================================
ALLOWED_ORIGINS=http://localhost:3000
