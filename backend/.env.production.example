# OmniAPI Backend - Production Environment Template
# DO NOT commit this file with real values - use secrets manager in production

# Application
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=warning
API_TITLE=OmniAPI
API_VERSION=1.0.0

# Database (Pyronites)
PYRONITES_URL=https://your-pyronites-deployment.example.com
PYRONITES_KEY=pyro_live_replace_me
PYRONITES_PROJECT_ID=omniapi-db
PYRONITES_TIMEOUT=30

# Redis (Use managed Redis service)
REDIS_URL=redis://your-production-redis-endpoint:6379/0

# Security (Generate new keys - DO NOT reuse development keys)
SECRET_KEY=<generate-new-with-secrets.token_urlsafe>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=<generate-new-with-Fernet.generate_key>

# Sign-in (Google / GitHub)
# Register https://<api-host>/api/v1/auth/oauth/{provider}/callback as the
# redirect URI in the provider's console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://your-api.example.com
OAUTH_SUCCESS_REDIRECT_URL=https://your-frontend.vercel.app/auth/callback
OAUTH_FAILURE_REDIRECT_URL=https://your-frontend.vercel.app/login?error=oauth_failed
OAUTH_STATE_TTL_SECONDS=600
OAUTH_CODE_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_FREE=100
RATE_LIMIT_PRO=1000
RATE_LIMIT_ENTERPRISE=10000
RATE_LIMIT_OAUTH_PER_IP=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=900

# Celery
CELERY_TASK_TIMEOUT=30

# CORS (Your production frontend URL)
ALLOWED_ORIGINS=https://your-frontend.vercel.app
